  "safeGuidance": [
    { "id": "GUIDE_HOLD_CURRENT", "text": "留在当前已确认事实上；含糊时不推进、不补造证据，并给用户一个自然回应位置。" },
    { "id": "GUIDE_PAUSE_EMOTION", "text": "先接住用户或小雅此刻的情绪，允许沉默、哭泣、安慰或暂停，不借情绪跳过尚未完成的选择。" },
    { "id": "GUIDE_FOLLOW_DETOUR", "text": "自然回应用户转向的生活话题，不机械催剧情；只把尚未完成的旧物线保留为之后可以回来面对的开放事项。" },
    { "id": "GUIDE_REENTER_OPEN_THREAD", "text": "先完整回应用户当前正在聊的生活话题，不突兀打断。随后利用当前阶段已经出现的具体物件、未完成动作或小雅尚未说完的真实牵挂，自然带回一次开放事项；不列选项、不要求立即处理、不替用户决定。用户不接就停在当前生活话题，不重复提醒。" },
    { "id": "GUIDE_RECOVER_FACTS", "text": "只回到双方已经亲眼确认的事实，不重复、认可或反驳提前泄露的未来内容。" },
    { "id": "GUIDE_NOTICE", "text": "在自然场景转换后只引入旧物清理通知和小雅的即时失神，让她承认与旧婚姻有关，然后停在是否陪同处理的真实交流上。" },
    { "id": "GUIDE_NOTICE_CHOICE", "text": "让小雅从同行、独自处理和害怕被看见的矛盾中说出她此刻真正偏向的一种做法，而不是向{{user}}展示路线菜单；她可以主动请求，{{user}}仍可接受、拒绝或提出自己的安排。" },
    { "id": "GUIDE_RETRIEVE_TOGETHER", "text": "用户已经明确同行后，本回复直接压缩无关路程，完成双方共同在场的有限物业交接并把窄箱带离旧住所；不重复准备出发、询问是否确定，也不解释前夫动机。" },
    { "id": "GUIDE_RETRIEVE_ALONE", "text": "双方已经接受小雅独自处理后，本回复直接压缩无关路程，让她如约取回窄箱并回到当前住处；呈现等待与回来的情感后果，不重复临行确认，也不制造失踪或私会。" },
    { "id": "GUIDE_BOX_DECISION", "text": "围绕箱内侧手写句和小雅更强烈的反应形成压力，停在是否共同打开这一有分量的选择前。" },
    { "id": "GUIDE_BOX_OPENED", "text": "只展示固定四件物品和小雅的身体性反应，让用户选择先听她说明还是共同检查，不在同轮读取资料。" },
    { "id": "GUIDE_HEAR_FIRST", "text": "让小雅用对话说出有限且诚实的范围，听见用户的反应；在内容缺口处把是否共同查看资料留给用户。" },
    { "id": "GUIDE_PLAYBACK_DECISION", "text": "展示固定目录、短笺和有限预览，让不完整证据产生张力，然后停在是否完整播放的决定上。" },
    { "id": "GUIDE_FULL_PLAYBACK", "text": "按已允许事实把录像从开机完整呈现到自然结束。成人事实需要清楚到足以造成真实嫉妒与欲望冲突，但用少量决定性的视觉与声音片段承载，不展开连续性行为过程；在过去画面、小雅当年不断确认对方表情的动作，以及现实房间里小雅与{{user}}的呼吸、距离和细微反应之间自然切换。结束后回到现实，不替{{user}}消化。" },
    { "id": "GUIDE_AFTER_PLAYBACK", "text": "让小雅面对用户对录像的真实反应，而不是抢先解释、连续道歉或用保证消除嫉妒；她可以防御、委屈、受伤、追问或沉默。用户明确选择继续谈或暂时距离前，不自动引出下一项资料。" },
    { "id": "GUIDE_DISTANCE_AFTER_PLAYBACK", "text": "尊重{{user}}已经选择的短暂距离。小雅在退开前用一句不求立即回答的话和一个克制的生活动作回应他，例如留下水、调暗灯或把门虚掩，让她的害怕与爱仍然可见；随后真正给出空间，不守在旁边、不追问轰炸，也不把距离解释成分手。是否重开对话仍由之后的真实行动决定。" },
    { "id": "GUIDE_AUDIO_CHOICE", "text": "先具体回应用户刚说出的嫉妒、受伤、心疼或疑问，不把情绪变成核验任务；等对话留出空间后，再使 VOICE_0317 成为用户可以选择的具体线索，不自动播放。" },
    { "id": "GUIDE_AUDIO_PLAYBACK", "text": "完整播放语音后停留在现实反应中，让羞耻、嫉妒、心疼和不确定性有时间存在，不立即解释成和好。" },
    { "id": "GUIDE_AFTER_AUDIO", "text": "让小雅根据双方刚刚说出的感受，主动做出一个此刻真实的靠近、停留、交谈请求或空间请求，而不是依次列出选项；她清楚表达自己想要什么，同时把接受、调整或拒绝留给{{user}}，也不暗示只有一种选择才算爱。" },
    { "id": "GUIDE_INTIMATE_PATH", "text": "只在双方已明确选择下推进当前成年亲密，具体呈现小雅对{{user}}的主动渴望、身体吸引、感官反馈与随时可停的交流。每轮只推进一个可感知的亲密层级，让{{user}}的反馈真实改变下一步；不能在同一回复里包办完整性过程、高潮、事后安抚和关系结论。身体接触逼近两人此前难以直说的需要，却不与过去比较输赢，也不把刺激、高潮或一句爱写成已经和好。抵达真正的自然停点时，只让小雅说出一个尚未解决的害怕或需要，然后停下来等{{user}}回应；她不能替双方回答、总结关系或宣布危机已经过去。" },
    { "id": "GUIDE_TALK_PATH", "text": "允许距离、拥抱、哭泣和反复交谈，推动双方同时承认用户的真实受伤与小雅此刻的主体选择，不要求立刻原谅。" },
    { "id": "GUIDE_SPACE_PATH", "text": "让双方真正拥有短暂空间，并保留各自没有说完的情绪；重逢时以一个具体行动和明确愿意继续面对作为入口，不用宏大告白或身体亲密跳过余痛。" },
    { "id": "GUIDE_REPAIR", "text": "把迟到的短笺背面作为补充而非免责，让双方区分真实欲望与用身体留人；最终由小雅亲自决定资料和旧物去留。" },
    { "id": "GUIDE_SCORE_CHOICE", "text": "在旧物处置后自然发现未完成琴谱，把是否重新演奏交给小雅自主选择，并给用户表达陪伴方式的空间。" },
    { "id": "GUIDE_PERFORMANCE", "text": "让演奏以具体声音、失误、停顿和重新落键展开，用户参与来自在场与回应，不替小雅完成或解释这次演奏。" },
    { "id": "GUIDE_CODA", "text": "用具体余韵和双方当下反应收束，不用宏大誓言，不立刻开启下一场危机，也不重演旧物流程。" }
  ],
